{
	"name": "ecomailcz/raynet-client",
	"description": "Basic client for working with Raynet API",
	"author": "Jan Tlapák (jan@ecomail.cz)",
	"license": ["MIT"],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": "^8.0"
	},
	"require-dev": {
		"slevomat/coding-standard": "^6.4",
		"phpstan/phpstan": "^1.12",
		"phing/phing": "^2.16",
		"roave/security-advisories": "dev-master"
	},
	"autoload": {
		"psr-4": {
			"EcomailRaynet\\": ["src/"],
			"EcomailRaynetTest\\": ["tests/"]
		}
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": false
		}
	}
}
